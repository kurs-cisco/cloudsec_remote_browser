# Cross-account SWG roles that may read RBI-owned secret values through the
# broad/default direct-role path. Any listed role is added to RBI secrets that
# inherit default read principals and receives KMS decrypt for those RBI secret
# ARN patterns. Keep this list restricted to trusted SWG roles.
swg_read_role_arns = [
  "arn:aws:iam::111122223333:role/swg-prod-rbi-secret-reader",
]

# Terraform creates the swg_handoff_shared_secret container, read policy, and
# KMS access only. The AWSCURRENT payload is generated by
# scripts/rbi-bootstrap-secrets.sh and must contain exactly kid and hmac_secret.

# Optional SWG-side credential handoff. Terraform can create the SWG-side
# credential secret container and an RBI-account IAM reader principal scoped to
# swg_handoff_shared_secret. It never creates or stores access-key material in
# Terraform state.
swg_credential_secret_enabled       = false
swg_credential_secret_region        = "us-west-2"
swg_credential_secret_name          = "rbi/prod/credentials/swg-rbi-secret-reader"
# Leave empty to have Terraform create a customer-managed key for cross-account reads.
swg_credential_secret_kms_key_id    = ""
# Use IAM principal ARNs here, not sts get-caller-identity assumed-role ARNs.
swg_credential_secret_read_principal_arns = [
  "arn:aws:iam::111122223333:role/swg-prod-proxy-pod-secret-reader",
]
swg_credential_reader_user_enabled     = false
swg_credential_reader_user_name        = "rbi-prod-swg-handoff-secret-reader"
swg_credential_secret_aws_profile      = ""

# Optional RBI KMS administrators.
kms_admin_principal_arns = [
  "arn:aws:iam::444455556666:role/rbi-prod-security-admin",
]

# Optional externally deployed rotation Lambdas. Terraform never supplies secret
# values except for explicitly enabled generated versions above.
rotation_lambda_arns = {
  session_token_signing = "arn:aws:lambda:us-east-1:444455556666:function:rbi-prod-data-session-token-signing-rotation"
}

# Optional public endpoint certificate. Leave blank when DNS is managed elsewhere.
public_certificate_domain_name    = "rbi.example.com"
public_certificate_hosted_zone_id = "Z00000000000000000000"
