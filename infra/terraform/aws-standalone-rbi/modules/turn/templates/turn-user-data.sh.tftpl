#!/usr/bin/env bash
set -euo pipefail
exec > >(tee /var/log/cloudsec-rbi-turn-user-data.log | logger -t cloudsec-rbi-turn-user-data -s 2>/dev/console) 2>&1

echo "cloudsec-rbi TURN bootstrap starting at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"

wait_for_package_manager() {
  for _ in $(seq 1 60); do
    if ! pgrep -x dnf >/dev/null 2>&1 && ! pgrep -x rpm >/dev/null 2>&1 && ! pgrep -x yum >/dev/null 2>&1; then
      return
    fi
    sleep 5
  done

  echo "package manager lock did not clear" >&2
  exit 1
}

install -d -o root -g root -m 0755 /etc/cloudsec-rbi
install -d -o root -g root -m 0755 /opt/cloudsec/turn

cat >/tmp/cloudsec-rbi-turn.service.b64 <<'EOF'
${turn_service_b64}
EOF
base64 -d /tmp/cloudsec-rbi-turn.service.b64 >/etc/systemd/system/cloudsec-rbi-turn.service
chmod 0644 /etc/systemd/system/cloudsec-rbi-turn.service

cat >/tmp/start-coturn.sh.b64 <<'EOF'
${start_coturn_script_b64}
EOF
base64 -d /tmp/start-coturn.sh.b64 >/opt/cloudsec/turn/start-coturn.sh
chmod 0755 /opt/cloudsec/turn/start-coturn.sh

cat >/etc/cloudsec-rbi/turn.env <<'EOF'
TURN_REALM=${realm}
TURN_SHARED_SECRET_SECRET_ID=${shared_secret_secret_id}
TURN_SHARED_SECRET_JSON_KEY=${shared_secret_json_key}
TURN_PORT=${turn_port}
TURN_TLS_PORT=${tls_port}
TURN_MIN_PORT=${relay_port_min}
TURN_MAX_PORT=${relay_port_max}
COTURN_IMAGE=${coturn_image}
EOF
chmod 0600 /etc/cloudsec-rbi/turn.env

wait_for_package_manager
dnf install -y docker awscli jq amazon-ssm-agent || dnf install -y docker awscli jq

systemctl daemon-reload
systemctl enable --now amazon-ssm-agent || true
systemctl enable --now docker
docker pull "${coturn_image}" || true
systemctl enable --now cloudsec-rbi-turn
systemctl status cloudsec-rbi-turn --no-pager || true
echo "cloudsec-rbi TURN bootstrap completed at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
