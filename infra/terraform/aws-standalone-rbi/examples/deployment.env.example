# Example deployment environment for the standalone CloudSec RBI Terraform stack.
# Usage:
#   set -a
#   source cloudsec_remote_browser/infra/terraform/aws-standalone-rbi/examples/deployment.env.example
#   set +a
#
# Values are placeholders. Do not put real secret values in this file.
# Terraform consumes variables prefixed with TF_VAR_. Complex values use JSON/HCL strings.

# AWS caller context. Override these before sourcing when targeting another
# account, region, or domain.
export AWS_PROFILE="${AWS_PROFILE:-rbi-prod-admin}"
export RBI_ACCOUNT_ID="${RBI_ACCOUNT_ID:-111122223333}"
export SWG_ACCOUNT_ID="${SWG_ACCOUNT_ID:-444455556666}"
export RBI_REGION="${RBI_REGION:-us-east-1}"
export RBI_DOMAIN="${RBI_DOMAIN:-rbi.example.com}"
export RBI_PRIVATE_DNS_NAME="${RBI_PRIVATE_DNS_NAME:-bootstrap.rbi.internal.example.com}"
export RBI_PUBLIC_INGRESS_CIDR="${RBI_PUBLIC_INGRESS_CIDR:-203.0.113.0/24}"
export RBI_ROUTE53_ZONE_ID="${RBI_ROUTE53_ZONE_ID:-Z00000000000000000000}"
export AWS_REGION="${RBI_REGION}"
export AWS_DEFAULT_REGION="${AWS_REGION}"

# Optional backend init helpers. These are not Terraform variables; pass them to
# terraform init -backend-config after applying bootstrap/remote-state.
export RBI_TF_STATE_BUCKET="cloudsec-rbi-prod-${RBI_ACCOUNT_ID}-${RBI_REGION}-tfstate"
export RBI_TF_LOCK_TABLE="cloudsec-rbi-prod-${RBI_REGION}-terraform-locks"

# Common stack identity.
export TF_VAR_project_name="cloudsec-rbi"
export TF_VAR_environment="prod"
export TF_VAR_aws_region="${AWS_REGION}"
export RBI_ECR_REPO_PREFIX="${TF_VAR_project_name}-${TF_VAR_environment}"
export TF_VAR_tags='{
  "Owner": "cloudsec-rbi",
  "CostCenter": "security",
  "DataClassification": "restricted"
}'

# Global/ECR root.
export TF_VAR_ecr_repositories='{
  "control-plane": {"image_tag_mutability": "IMMUTABLE", "max_image_count": 100},
  "session-authority": {"image_tag_mutability": "IMMUTABLE", "max_image_count": 100},
  "media-gateway": {"image_tag_mutability": "IMMUTABLE", "max_image_count": 100},
  "worker": {"image_tag_mutability": "IMMUTABLE", "max_image_count": 50},
  "file-broker": {"image_tag_mutability": "IMMUTABLE", "max_image_count": 50},
  "clipboard-broker": {"image_tag_mutability": "IMMUTABLE", "max_image_count": 50}
}'

# Network root.
export RBI_AZ_1="${RBI_AZ_1:-${RBI_REGION}a}"
export RBI_AZ_2="${RBI_AZ_2:-${RBI_REGION}b}"
export RBI_AZ_3="${RBI_AZ_3:-${RBI_REGION}c}"
export TF_VAR_availability_zones="[\"${RBI_AZ_1}\", \"${RBI_AZ_2}\", \"${RBI_AZ_3}\"]"
export TF_VAR_vpc_cidr="10.72.0.0/16"
export TF_VAR_public_subnet_cidrs='["10.72.0.0/24", "10.72.1.0/24", "10.72.2.0/24"]'
export TF_VAR_private_subnet_cidrs='["10.72.16.0/20", "10.72.32.0/20", "10.72.48.0/20"]'
export TF_VAR_data_subnet_cidrs='["10.72.96.0/24", "10.72.97.0/24", "10.72.98.0/24"]'
export TF_VAR_enable_nat_gateway="true"
export TF_VAR_single_nat_gateway="false"
export TF_VAR_viewer_ingress_cidrs="[\"${RBI_PUBLIC_INGRESS_CIDR}\"]"
export TF_VAR_turn_client_cidrs="[\"${RBI_PUBLIC_INGRESS_CIDR}\"]"
export TF_VAR_viewer_certificate_arn="arn:aws:acm:${RBI_REGION}:${RBI_ACCOUNT_ID}:certificate/00000000-0000-0000-0000-000000000000"
export TF_VAR_public_endpoint_hostname="${RBI_DOMAIN}"
export TF_VAR_turn_hostname="turn.${RBI_DOMAIN}"
export TF_VAR_privatelink_private_dns_name="${RBI_PRIVATE_DNS_NAME}"
export TF_VAR_privatelink_allowed_principals="[
  \"arn:aws:iam::${SWG_ACCOUNT_ID}:root\"
]"
export TF_VAR_privatelink_acceptance_required="true"
export TF_VAR_turn_ami_id="ami-00000000000000000"
export TF_VAR_turn_instance_type="t3.small"
export TF_VAR_turn_min_size="2"
export TF_VAR_turn_desired_capacity="2"
export TF_VAR_turn_max_size="4"
export TF_VAR_turn_nlb_eip_allocation_ids='[]'
export TF_VAR_redis_node_type="cache.t4g.small"
export TF_VAR_redis_node_count="2"
export TF_VAR_redis_engine_version="7.1"

# Data/security root. RBI owns these Secrets Manager containers and KMS keys.
# Secret values must be populated by a secure bootstrap/rotation flow, not Terraform.
export TF_VAR_kms_admin_principal_arns="[
  \"arn:aws:iam::${RBI_ACCOUNT_ID}:role/rbi-prod-security-admin\"
]"
export TF_VAR_swg_read_role_arns="[
  \"arn:aws:iam::${SWG_ACCOUNT_ID}:role/swg-prod-rbi-secret-reader\"
]"
export RBI_SWG_AUTH_SIGN_SECRET_NAME="${RBI_SWG_AUTH_SIGN_SECRET_NAME:-${RBI_PROJECT_NAME}/${RBI_ENVIRONMENT}/data/swg_handoff_shared_secret}"
export RBI_SWG_AUTH_SIGN_SECRET_REGION="${RBI_SWG_AUTH_SIGN_SECRET_REGION:-${RBI_REGION}}"
export RBI_SWG_AUTH_SIGN_SECRET_VALUE_FIELD="${RBI_SWG_AUTH_SIGN_SECRET_VALUE_FIELD:-hmac_secret}"
export RBI_SWG_AUTH_SIGN_SECRET_KID_FIELD="${RBI_SWG_AUTH_SIGN_SECRET_KID_FIELD:-kid}"
export RBI_SWG_AUTH_SIGN_ROLE_ARN="${RBI_SWG_AUTH_SIGN_ROLE_ARN:-arn:aws:iam::${SWG_ACCOUNT_ID}:role/swg-${RBI_ENVIRONMENT}-rbi-secret-reader}"
export RBI_AUTH_SIGN_SECRET_NAME="${RBI_AUTH_SIGN_SECRET_NAME:-${RBI_SWG_AUTH_SIGN_SECRET_NAME}}"
export RBI_AUTH_SIGN_SECRET_REGION="${RBI_AUTH_SIGN_SECRET_REGION:-${RBI_SWG_AUTH_SIGN_SECRET_REGION}}"
export RBI_AUTH_SIGN_SECRET_VALUE_FIELD="${RBI_AUTH_SIGN_SECRET_VALUE_FIELD:-${RBI_SWG_AUTH_SIGN_SECRET_VALUE_FIELD}}"
export RBI_AUTH_SIGN_SECRET_KID_FIELD="${RBI_AUTH_SIGN_SECRET_KID_FIELD:-${RBI_SWG_AUTH_SIGN_SECRET_KID_FIELD}}"
export RBI_AUTH_SIGN_AWS_CREDENTIAL_SOURCE="${RBI_AUTH_SIGN_AWS_CREDENTIAL_SOURCE:-env}"
export RBI_AUTH_SIGN_ROLE_ARN="${RBI_AUTH_SIGN_ROLE_ARN:-${RBI_SWG_AUTH_SIGN_ROLE_ARN}}"
export TF_VAR_rotation_lambda_arns='{}'
export TF_VAR_default_rotation_days="30"
export TF_VAR_public_certificate_domain_name="${RBI_DOMAIN}"
export TF_VAR_public_certificate_subject_alternative_names="[\"*.${RBI_DOMAIN}\"]"
export TF_VAR_public_certificate_hosted_zone_id="${RBI_ROUTE53_ZONE_ID}"
export TF_VAR_wait_for_public_certificate_validation="false"
export TF_VAR_private_cas='{
  "rbi_client_trust": {
    "type": "ROOT",
    "key_algorithm": "RSA_2048",
    "signing_algorithm": "SHA256WITHRSA",
    "usage_mode": "GENERAL_PURPOSE",
    "permanent_deletion_time_in_days": 30,
    "subject": {
      "common_name": "rbi-prod-client-trust-root",
      "organization": "RBI",
      "organizational_unit": "Remote Browser Isolation",
      "country": "US"
    },
    "tags": {"RbiUse": "mtls-client-trust"}
  }
}'
export TF_VAR_private_ca_permissions='{}'
export TF_VAR_trust_bundles='{
  "swg_client_trust": {
    "description": "RBI mTLS trust bundle metadata for SWG client authentication.",
    "pca_key": "rbi_client_trust",
    "version": "v1",
    "create_ssm_parameter": true,
    "tags": {"RbiUse": "swg-client-mtls"}
  }
}'
export TF_VAR_observability_event_target_arns='[]'
export TF_VAR_observability_log_retention_days="180"
export TF_VAR_observability_log_group_kms_key_id=""

# EKS/Kata root. Fill subnet IDs from the network root outputs before applying.
export TF_VAR_cluster_name="cloudsec-rbi-prod-${RBI_REGION}"
export TF_VAR_cluster_version="1.35"
export TF_VAR_cluster_subnet_ids='["subnet-aaaaaaaaaaaaaaaaa", "subnet-bbbbbbbbbbbbbbbbb", "subnet-ccccccccccccccccc"]'
export TF_VAR_standard_node_subnet_ids='[]'
export TF_VAR_kata_node_subnet_ids='[]'
export TF_VAR_cluster_security_group_ids='[]'
export TF_VAR_cluster_encryption_key_arn=""
export TF_VAR_enabled_cluster_log_types='["api", "audit", "authenticator", "controllerManager", "scheduler"]'
export TF_VAR_kata_security_group_ids='[]'
export TF_VAR_endpoint_private_access="true"
export TF_VAR_endpoint_public_access="true"
export TF_VAR_public_access_cidrs='["203.0.113.0/24"]'
export TF_VAR_standard_node_instance_types='["m6i.large"]'
export TF_VAR_standard_node_min_size="2"
export TF_VAR_standard_node_desired_size="2"
export TF_VAR_standard_node_max_size="4"
export TF_VAR_kata_worker_ami_id="ami-0123456789abcdef0"
export TF_VAR_kata_worker_capacity_type="SPOT"
export TF_VAR_kata_worker_instance_type="c5.metal"
export TF_VAR_kata_worker_instance_types='["c5n.metal", "c5.metal", "c6a.metal", "c6i.metal", "m6i.metal"]'
export TF_VAR_kata_node_min_size="1"
export TF_VAR_kata_node_desired_size="2"
export TF_VAR_kata_node_max_size="10"

# Kubernetes apps root.
export TF_VAR_runtime_class_name="kata-clh"
export TF_VAR_control_namespace="cloudsec-rbi-control"
export TF_VAR_worker_namespace="cloudsec-rbi-workers"
export TF_VAR_create_control_namespace="true"
export TF_VAR_control_plane_replicas="2"
export TF_VAR_runtime_image="${RBI_ACCOUNT_ID}.dkr.ecr.${RBI_REGION}.amazonaws.com/${RBI_ECR_REPO_PREFIX}-control-plane:prod"
export TF_VAR_session_authority_image="${RBI_ACCOUNT_ID}.dkr.ecr.${RBI_REGION}.amazonaws.com/${RBI_ECR_REPO_PREFIX}-session-authority:prod"
export TF_VAR_media_gateway_image="${RBI_ACCOUNT_ID}.dkr.ecr.${RBI_REGION}.amazonaws.com/${RBI_ECR_REPO_PREFIX}-media-gateway:prod"
export TF_VAR_file_broker_image="${RBI_ACCOUNT_ID}.dkr.ecr.${RBI_REGION}.amazonaws.com/${RBI_ECR_REPO_PREFIX}-file-broker:prod"
export TF_VAR_clipboard_broker_image="${RBI_ACCOUNT_ID}.dkr.ecr.${RBI_REGION}.amazonaws.com/${RBI_ECR_REPO_PREFIX}-clipboard-broker:prod"
export TF_VAR_worker_image="${RBI_ACCOUNT_ID}.dkr.ecr.${RBI_REGION}.amazonaws.com/${RBI_ECR_REPO_PREFIX}-worker:prod"
export TF_VAR_pool_replicas="2"
export TF_VAR_worker_shared_config='{
  "POOL_WS_URL": "wss://'${RBI_DOMAIN}'/ws/pool",
  "SIGNALING_URL": "wss://'${RBI_DOMAIN}'/ws/worker",
  "WORKER_ICE_URLS": "turn:turn.'${RBI_DOMAIN}':3478?transport=udp,turn:turn.'${RBI_DOMAIN}':3478?transport=tcp,turns:turn.'${RBI_DOMAIN}':443?transport=tcp",
  "ALLOWED_CANDIDATE_TYPES": "relay",
  "DISPLAY_WIDTH": "1280",
  "DISPLAY_HEIGHT": "720",
  "CAPTURE_FRAMERATE": "20",
  "VIDEO_CODEC_PREFERENCES": "VP8",
  "VIDEO_MIN_BITRATE_BPS": "600000",
  "VIDEO_START_BITRATE_BPS": "1500000",
  "VIDEO_MAX_BITRATE_BPS": "3000000"
}'

# Runtime secret values are not set here. Populate these secret containers after
# the data root creates them: session_token_signing, swg_handoff_shared_secret,
# turn_shared_secret, pool_worker_shared_secret, mtls_client_bootstrap.
