project_name = "cloudsec-rbi"
environment  = "prod"

# Concrete first-region example. For a region-neutral template, use
# prod-regional-network.auto.tfvars.example and replace the regional values.
aws_region   = "us-east-1"

availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]
vpc_cidr           = "10.72.0.0/16"

public_subnet_cidrs  = ["10.72.0.0/24", "10.72.1.0/24", "10.72.2.0/24"]
private_subnet_cidrs = ["10.72.16.0/20", "10.72.32.0/20", "10.72.48.0/20"]
data_subnet_cidrs    = ["10.72.96.0/24", "10.72.97.0/24", "10.72.98.0/24"]

enable_nat_gateway = true
single_nat_gateway = false

# Use explicit enterprise/SWG edge CIDRs. Leaving these empty creates no public ingress rules.
viewer_ingress_cidrs = ["203.0.113.0/24"]
turn_client_cidrs    = ["203.0.113.0/24"]

# Certificate provisioning is intentionally out of scope.
# viewer_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

# Use a pre-baked TURN AMI for production. Secret access policies are managed outside this module.
# turn_ami_id = "ami-00000000000000000"

redis_node_type  = "cache.t4g.small"
redis_node_count = 2

tags = {
  Owner      = "platform"
  CostCenter = "security"
}
