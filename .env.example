NODE_ENV=production
PORT=8080
PUBLIC_BASE_URL=https://remote-browser.example.com
PUBLIC_WS_URL=wss://remote-browser.example.com/ws
WORKER_WS_URL=wss://remote-browser.example.com/ws/worker

TOKEN_SECRET=replace-with-strong-session-token-secret
TURN_SHARED_SECRET=replace-with-coturn-rest-secret
SWG_SHARED_SECRET=replace-with-swg-bootstrap-hmac-secret
ENABLE_SWG_BOOTSTRAP=1
SWG_BOOTSTRAP_LOCAL_ONLY=0
SWG_BOOTSTRAP_ALLOWED_CONTRACT_VERSIONS=v2
SWG_BOOTSTRAP_ALLOWED_REQUEST_KINDS=http-document,https-decrypted-document
SWG_BOOTSTRAP_ALLOWED_ORIGINAL_METHODS=GET,HEAD
SWG_BOOTSTRAP_ALLOWED_PROVIDERS=in_house
SWG_BOOTSTRAP_ALLOWED_PROVIDER_CATEGORIES=cat-b
RBI_FALLBACK_PROVIDER=menlo
SWG_TIMESTAMP_TOLERANCE_MS=90000
SWG_REPLAY_TTL_MS=600000

SESSION_STORE_BACKEND=redis
SIGNAL_BUS_BACKEND=redis
REDIS_URL=rediss://redis.example.com:6379
REDIS_TLS=1

VIEWER_ICE_URLS=turns:turn.example.com:443?transport=tcp,turn:turn.example.com:3478?transport=udp
WORKER_ICE_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
ALLOWED_ICE_CANDIDATE_TYPES=relay
VIEWER_ICE_TRANSPORT_POLICY=relay

WORKER_LAUNCH_MODE=host-agent
WORKER_IMAGE=cloudsec-remote-browser-worker
HOST_AGENT_SECRET=replace-with-host-agent-secret
HOST_AGENT_DISCOVERY_URLS=https://worker-host-a.example.internal,https://worker-host-b.example.internal
